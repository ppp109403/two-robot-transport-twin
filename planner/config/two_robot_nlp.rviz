Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Name: SDF (clearance)
      Enabled: false
      Topic:
        Value: /sdf_viz
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6
    - Class: rviz_default_plugins/Path
      Name: seed (A*)
      Enabled: true
      Topic:
        Value: /seed_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 130; 130; 130
      Line Style: Lines
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: object
      Enabled: true
      Topic:
        Value: /object_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 150; 90; 40
      Line Style: Lines
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: base A
      Enabled: true
      Topic:
        Value: /a/base_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 25; 180; 50
      Line Style: Lines
      Pose Style: Arrows
      Arrow Length: 0.15
    - Class: rviz_default_plugins/Path
      Name: base B
      Enabled: true
      Topic:
        Value: /b/base_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 25; 80; 230
      Line Style: Lines
      Pose Style: Arrows
      Arrow Length: 0.15
    - Class: rviz_default_plugins/Path
      Name: EE A
      Enabled: true
      Topic:
        Value: /a/ee_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 120; 240; 140
      Line Style: Lines
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: EE B
      Enabled: true
      Topic:
        Value: /b/ee_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 130; 180; 255
      Line Style: Lines
      Pose Style: None
    - Class: rviz_default_plugins/MarkerArray
      Name: ghosts (swept corridor)
      Enabled: true
      Topic:
        Value: /two_robot_plan/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: animation
      Enabled: true
      Topic:
        Value: /two_robot_plan/animation
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/InteractiveMarkers
      Name: EXECUTE button
      Enabled: true
      Interactive Markers Namespace: /plan_control
      Show Axes: false
      Show Descriptions: false
      Show Visual Aids: false
      Enable Transparency: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    # Interact must be first so it is the default tool -- the EXECUTE button is
    # an interactive marker and is only clickable while Interact is active.
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Scale: 30
      Target Frame: map
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
